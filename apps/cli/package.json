{
  "name": "pdf-scrubber",
  "version": "1.0.0",
  "description": "Edit supported machine-readable PDF text locally in your browser.",
  "license": "MIT",
  "author": "DrTralala <drtralala@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrTralala/PDF-Scrubber.git"
  },
  "homepage": "https://github.com/DrTralala/PDF-Scrubber#readme",
  "bugs": {
    "url": "https://github.com/DrTralala/PDF-Scrubber/issues"
  },
  "keywords": [
    "pdf",
    "editor",
    "browser",
    "local",
    "privacy"
  ],
  "type": "module",
  "bin": {
    "pdf-scrubber": "bin/pdf-scrubber.js"
  },
  "files": [
    "bin/",
    "lib/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "prepack": "node --input-type=module -e \"import { access } from 'node:fs/promises'; await access('dist/index.html');\""
  },
  "dependencies": {
    "open": "11.0.0"
  }
}
